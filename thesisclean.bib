@article{vyasConstructingSocioeconomicStatus2006a,
  title = {Constructing Socio-Economic Status Indices: How to Use Principal Components Analysis},
  shorttitle = {Constructing Socio-Economic Status Indices},
  author = {Vyas, Seema and Kumaranayake, Lilani},
  year = {2006},
  month = nov,
  journal = {Health Policy and Planning},
  volume = {21},
  number = {6},
  pages = {459--468},
  issn = {0268-1080},
  doi = {10.1093/heapol/czl029},
  url = {https://doi.org/10.1093/heapol/czl029},
  urldate = {2025-08-15},
  abstract = {Theoretically, measures of household wealth can be reflected by income, consumption or expenditure information. However, the collection of accurate income and consumption data requires extensive resources for household surveys. Given the increasingly routine application of principal components analysis (PCA) using asset data in creating socio-economic status (SES) indices, we review how PCA-based indices are constructed, how they can be used, and their validity and limitations. Specifically, issues related to choice of variables, data preparation and problems such as data clustering are addressed. Interpretation of results and methods of classifying households into SES groups are also discussed. PCA has been validated as a method to describe SES differentiation within a population. Issues related to the underlying data will affect PCA and this should be considered when generating and interpreting results.},
}

@incollection{wangGoogleEarthEngine2021,
  title = {Google {{Earth Engine Advancing Urban Land Change Science}}},
  booktitle = {Urban {{Remote Sensing}}},
  author = {Wang, Le and Yin, Dameng and Tian, Jinyan and Lu, Ying},
  year = {2021},
  pages = {175--188},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/9781119625865.ch9},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781119625865.ch9},
  urldate = {2025-08-11},
  abstract = {As a prominent cloud-based remote sensing platform, Google Earth Engine (GEE) emerged as a new avenue for addressing urban land change science, which aims to uncover how urban land has changed in response to both anthropogenic and natural drivers. In this chapter, we provide an in-depth introduction of both the technical and scientific aspects of GEE. In particular, we reviewed GEE progress in four specific areas of urban studies: urban extent mapping, urbanization estimation, urban ecosystem characterization, and city accessibility assessment. Two state-of-the-art research examples were then further elaborated to echo the urban extent mapping and ecosystem characterization, respectively. At the end, we summarize the advantages of GEE in urban land change science and provide future prospects .},
  chapter = {9},
  copyright = {{\copyright} 2022 John Wiley \& Sons Ltd.},
  isbn = {978-1-119-62586-5},
  langid = {english},
  keywords = {Google Earth Engine,knowledge-guided methods,land change science,urban remote sensing}
}

@article{wangHumanActivityChanges2022,
  title = {Human {{Activity Changes During COVID}}-19 {{Lockdown}} in {{China}}---{{A View From Nighttime Light}}},
  author = {Wang, Xuejun and Yan, Guangjian and Mu, Xihan and Xie, Donghui and Xu, Jiachen and Zhang, Zhiyu and Zhang, Dingdan},
  year = {2022},
  month = aug,
  journal = {GeoHealth},
  volume = {6},
  number = {8},
  pages = {e2021GH000555},
  issn = {2471-1403},
  doi = {10.1029/2021GH000555},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9350096/},
  urldate = {2025-08-12},
  abstract = {Strict lockdowns were implemented in China to fight Coronavirus Disease 2019 (COVID-19). We explored the nighttime light (NTL) of China's four cities in five stages of COVID-19 including case free period, newly appeared period, rising period, outbreak period, and stationary period. Using six categories of points of interest data (``company,'' ``recreation,'' ``healthcare,'' ``residence,'' ``shopping,'' and ``traffic facility'') and random forest models, we found that dimming light of four cities is associated with the epidemic development and human activity changes. When confirmed cases appeared, healthcare associated NTL radiance increased rapidly in Wuhan and Guangzhou, but decreased in the fourth and fifth stages. Companies in all cities were resuscitated in the fifth stage, while companies in Guangzhou was resuscitated in the fourth stage. Shopping related NTL radiance in Wuhan increased quickly in the fifth stage which indicated some resuscitation. In addition, compared to gross domestic product, the trend in electric power consumption was consistent with the trend in NTL radiance. The above findings contribute to the making of control policies for COVID-19 as well as other infectious diseases.,  Dimming light during Coronavirus disease 2019 lockdown observed by satellite coincides with the stage of epidemic developmentChanges in six categories of human activity can be considerably explained by nighttime light (NTL) changes (around 52\%)GDP (or electric power consumption) has a consistent trend with the NTL radiance},
  pmcid = {PMC9350096},
  pmid = {35942293},
}

